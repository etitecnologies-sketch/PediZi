# ═══════════════════════════════════════════════════
# PEDIZI API — Variáveis de Ambiente PRODUÇÃO
# Copie para .env no Railway ou servidor de produção
# ═══════════════════════════════════════════════════

# ── App ───────────────────────────────────────────
NODE_ENV=production
APP_PORT=3333
APP_URL=https://api.pedizi.com.br
FRONTEND_URL=https://pedizi.com.br
ADMIN_URL=https://admin.pedizi.com.br
RESTAURANT_URL=https://restaurante.pedizi.com.br
RUN_MIGRATIONS=true

# ── Banco de Dados (Supabase) ────────────────────
# Copie a connection string do painel do Supabase
# Settings > Database > Connection Pooling (Transaction mode, port 6543)
DATABASE_URL=postgresql://postgres:[SENHA]@db.[PROJETO].supabase.co:6543/postgres?pgbouncer=true&connection_limit=10

# ── Redis (Upstash) ───────────────────────────────
# Copie do painel Upstash: Database > Details
REDIS_URL=rediss://default:[TOKEN]@[HOST].upstash.io:6380
# OU separado:
REDIS_HOST=seu-redis.upstash.io
REDIS_PORT=6380
REDIS_PASSWORD=seu_token_upstash
REDIS_TLS=true

# ── JWT ──────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=GERE_UM_SECRET_ALEATORIO_MINIMO_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GERE_OUTRO_SECRET_ALEATORIO_MINIMO_64_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth ──────────────────────────────────
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret
GOOGLE_CALLBACK_URL=https://api.pedizi.com.br/api/v1/auth/google/callback

# ── Cloudinary (imagens) ─────────────────────────
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# ── Mercado Pago (PIX) ───────────────────────────
# Painel Mercado Pago > Credenciais
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_PUBLIC_KEY=APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=sua_assinatura_secreta

# ── E-mail (SMTP) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@pedizi.com.br
SMTP_PASS=sua_senha_de_app_gmail
EMAIL_FROM="PEDIZI <noreply@pedizi.com.br>"
