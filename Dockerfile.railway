# ── PEDIZI API — Dockerfile Railway (standalone npm) ──────────
FROM node:20-alpine AS builder
WORKDIR /app

RUN apk add --no-cache openssl python3 make g++

# Copia arquivos da API
COPY apps/api/package.json ./package.json
COPY apps/api/nest-cli.json ./nest-cli.json
COPY apps/api/tsconfig.json ./tsconfig.json
COPY apps/api/tsconfig.build.json ./tsconfig.build.json
COPY apps/api/prisma ./prisma
COPY apps/api/src ./src

# Instala todas as dependências
RUN npm install --legacy-peer-deps

# Gera Prisma Client
RUN npx prisma generate --schema ./prisma/schema.prisma

# Compila TypeScript
RUN npx nest build

# Verifica que o build existiu
RUN ls -la dist/ && echo "✅ dist/ encontrado"

# ── Runner ─────────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

RUN apk add --no-cache openssl curl

ENV NODE_ENV=production

# Copia package.json e instala apenas produção
COPY apps/api/package.json ./package.json
RUN npm install --only=production --legacy-peer-deps

# Copia dist compilado do builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma

# Copia Prisma Client gerado
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma

# Verifica
RUN ls -la dist/ && ls dist/main.js && echo "✅ dist/main.js presente"

EXPOSE 3333

HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=5 \
  CMD curl -f http://localhost:3333/api/v1/health || exit 1

CMD ["node", "dist/main"]
